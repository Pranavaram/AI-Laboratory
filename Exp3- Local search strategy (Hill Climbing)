import random

class HillClimbingNQueens:
    def __init__(self, n=8, max_sideways=100):
        self.n = n
        self.max_sideways = max_sideways
    def generate_random_state(self):
        return [random.randint(0, self.n - 1) for _ in range(self.n)]
    def calculate_heuristic(self, state):
        conflicts = 0
        for i in range(self.n):
            for j in range(i + 1, self.n):
                if state[i] == state[j]:
                    conflicts += 1
                elif abs(state[i] - state[j]) == abs(i - j):
                    conflicts += 1
        return conflicts

    def get_best_neighbor(self, current_state):
          best_state = list(current_state)
        best_h = self.calculate_heuristic(current_state)

        for col in range(self.n):
            for row in range(self.n):
                if current_state[col] == row:
                    continue  # Skip current position

                neighbor = list(current_state)
                neighbor[col] = row
                neighbor_h = self.calculate_heuristic(neighbor)

                if neighbor_h < best_h:
                    best_h = neighbor_h
                    best_state = neighbor

        return best_state, best_h
    def solve(self, max_restarts=50):
               for restart in range(max_restarts):
            current_state = self.generate_random_state()
            current_h = self.calculate_heuristic(current_state)
            sideways_moves = 0
            while True:
                               if current_h == 0:
                    return current_state, restart

                neighbor_state, neighbor_h = self.get_best_neighbor(current_state)

                             if neighbor_h < current_h:
                    current_state = neighbor_state
                    current_h = neighbor_h
                    sideways_moves = 0  # Reset plateau counter

                        elif neighbor_h == current_h and sideways_moves < self.max_sideways:
                    current_state = neighbor_state
                    sideways_moves += 1
               else:
                    break

        return None, max_restarts


def print_board(state):
     n = len(state)
    for row in range(n):
        line = ""
        for col in range(n):
            if state[col] == row:
                line += " Q "
            else:
                line += " . "
        print(line)


if __name__ == "__main__":
    n_queens = 8
    solver = HillClimbingNQueens(n=n_queens, max_sideways=50)
    solution, restarts = solver.solve(max_restarts=100)

    print("=== Hill Climbing Search Result ===")
    if solution:
        print(f"Goal State Found after {restarts} restart(s)!")
        print(f"State Representation (Column -> Row index): {solution}")
        print(f"Total Conflicts: {solver.calculate_heuristic(solution)}\n")
        print("Board Visualization:")
        print_board(solution)
    else:
        print("Failed to reach goal state within maximum allowed restarts.")
