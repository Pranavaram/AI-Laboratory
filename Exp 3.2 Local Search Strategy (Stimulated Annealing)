import math
import random
class SimulatedAnnealingNQueens:

    def __init__(
        self, n=8, initial_temp=1000.0, cooling_rate=0.995, min_temp=0.001
    ):
        self.n = n
        self.initial_temp = initial_temp
        self.cooling_rate = cooling_rate
        self.min_temp = min_temp

    def generate_random_state(self):
        return [random.randint(0, self.n - 1) for _ in range(self.n)]

    def calculate_heuristic(self, state):
        conflicts = 0
        for i in range(self.n):
            for j in range(i + 1, self.n):
                if state[i] == state[j]: 
                    conflicts += 1
                elif abs(state[i] - state[j]) == abs(
                    i - j
                ):
                    conflicts += 1
        return conflicts

    def get_random_neighbor(self, state):
        neighbor = list(state)
        col = random.randint(0, self.n - 1)
        new_row = random.randint(0, self.n - 1)
        while new_row == state[col]:
            new_row = random.randint(0, self.n - 1)

        neighbor[col] = new_row
        return neighbor

    def solve(self, max_iterations=50000):
        current_state = self.generate_random_state()
        current_h = self.calculate_heuristic(current_state)

        temp = self.initial_temp

        for iteration in range(1, max_iterations + 1):
            if current_h == 0:
                return current_state, iteration

            if temp <= self.min_temp:
                break
            neighbor_state = self.get_random_neighbor(current_state)
            neighbor_h = self.calculate_heuristic(neighbor_state)
            delta_e = neighbor_h - current_h
            if delta_e < 0:
                current_state = neighbor_state
                current_h = neighbor_h
            else:
                acceptance_probability = math.exp(-delta_e / temp)
                if random.random() < acceptance_probability:
                    current_state = neighbor_state
                    current_h = neighbor_h
            temp *= self.cooling_rate

        return None, max_iterations


def print_board(state):
    n = len(state)
    for row in range(n):
        line = ""
        for col in range(n):
            if state[col] == row:
                line += " Q "
            else:
                line += " . "
        print(line)
if __name__ == "__main__":
    n_queens = 8
    solver = SimulatedAnnealingNQueens(
        n=n_queens, initial_temp=1000.0, cooling_rate=0.995
    )
    solution, iterations = solver.solve()
    print("=== Simulated Annealing Search Result ===")
    if solution:
        print(f"Goal State Found in {iterations} iterations!")
        print(f"State Representation (Column -> Row index): {solution}")
        print(f"Total Conflicts: {solver.calculate_heuristic(solution)}\n")
        print("Board Visualization:")
        print_board(solution)
    else:
        print("Failed to reach goal state before cooling down.")
